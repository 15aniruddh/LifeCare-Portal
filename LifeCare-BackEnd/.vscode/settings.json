{
  // SQLTools connection to the local docker compose Postgres
  // (service "db" in python/docker-compose.yml, container python-db-1).
  // Requires: mtxr.sqltools + mtxr.sqltools-driver-pg
  // Local development credentials only.
  "sqltools.connections": [
    {
      "name": "LifeCare (local docker)",
      "driver": "PostgreSQL",
      "server": "localhost",
      "port": 5432,
      "database": "lifecare",
      "username": "lifecare",
      "password": "lifecare",
      "askForPassword": false,
      "connectionTimeout": 15,
      "previewLimit": 50
    }
  ],
  "sqltools.useNodeRuntime": true
}
