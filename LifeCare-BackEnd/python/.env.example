# ---------------------------------------------------------------------
# Copy to .env and fill in. Never commit the real .env.
# ---------------------------------------------------------------------

# ---- Application ----
APP_NAME="LifeCare Portal API"
ENV=local                 # local | dev | staging | production
DEBUG=false
PORT=9091                 # the port the existing React frontend calls
LOG_LEVEL=INFO
LOG_JSON=true

# ---- PostgreSQL ----
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=lifecare
POSTGRES_USER=lifecare
POSTGRES_PASSWORD=
# Or set the whole URL at once (wins over the POSTGRES_* values above):
# DATABASE_URL=postgresql://user:pass@host:5432/lifecare
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_ECHO=false

# ---- Security ----
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=480
BCRYPT_ROUNDS=10
# Set to false ONLY while the frontend is still being wired up for JWT.
AUTH_ENABLED=true
LOGIN_RATE_LIMIT_ATTEMPTS=10
LOGIN_RATE_LIMIT_WINDOW_SECONDS=60

# ---- CORS ----
# Comma-separated. "*" is refused when ENV is staging or production.
CORS_ORIGINS=http://localhost:3000

# ---- Google OAuth ("Sign in with Google") ----
# From the Google Cloud console:
#   APIs & Services -> Credentials -> Create credentials -> OAuth client ID
#   -> Web application. Register GOOGLE_REDIRECT_URI below, verbatim, under
#   that client's "Authorised redirect URIs".
# Put the real values in .env (git-ignored), NEVER in this file - .env.example
# is committed, and GitHub push protection will block the push if it carries a
# real client secret.
# Flip GOOGLE_OAUTH_ENABLED to true once both values below are filled in; the
# login page hides the Google button while it is false, and the server refuses
# to start if it is true with either value missing.
GOOGLE_OAUTH_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:9091/login/google/callback
# First Google sign-in for an unknown address registers a patient account.
GOOGLE_AUTO_CREATE_USERS=true
# Where the callback hands the browser back to.
FRONTEND_BASE_URL=http://localhost:3000

# ---- Mail (registration welcome email) ----
MAIL_ENABLED=false
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@lifecare.example
MAIL_STARTTLS=true

# ---- Source database, only for scripts/migrate_mysql_to_postgres.py ----
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=lifecare
MYSQL_USER=root
MYSQL_PASSWORD=
