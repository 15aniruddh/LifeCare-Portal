# Copy to .env and adjust if the backend is not on localhost.
# Create React App only exposes REACT_APP_* variables, and reads them at build
# time — restart the dev server after changing this file.

# The FastAPI backend. Also where the "Continue with Google" button sends the
# browser: it hits <this>/login/google, and the server redirects back here.
REACT_APP_API_BASE_URL=http://localhost:9091
